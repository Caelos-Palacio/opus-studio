{
  "dsl": 1,
  "id": "K09",
  "doc": "K09 · pulsos 16 → 20 (compás 5). Cuatro filas de SECUENCIADOR entran una por pulso (PUM, TIC, CLAC, TOC). Cada fila se enciende con SU pista de audio: bombo → PUM, hats → TIC, caja/palmas → CLAC, toms → TOC (parámetros kick/hat/snare/tom enlazados a audio.json.tracks). La música dibuja la imagen.",
  "libs": {
    "K_tipo": "./K_tipo.mjs"
  },
  "fns": {
    "since": {
      "lib": "K_tipo",
      "fn": "since",
      "bind": [
        "film",
        "shot",
        "t"
      ]
    },
    "fit": {
      "lib": "K_tipo",
      "fn": "fit"
    },
    "shake": {
      "lib": "K_tipo",
      "fn": "shake",
      "bind": [
        "P",
        "t"
      ],
      "reads": [
        "chaos"
      ]
    },
    "snapTo": {
      "lib": "K_tipo",
      "fn": "snapTo",
      "bind": [
        "api"
      ]
    }
  },
  "params": {
    "kick": {
      "type": "number",
      "range": [
        0,
        2
      ],
      "default": 0,
      "semantic": "envolvente de los onsets del bombo: golpe de escala"
    },
    "snare": {
      "type": "number",
      "range": [
        0,
        2
      ],
      "default": 0,
      "semantic": "envolvente de caja/palmas/toms: destello y corte de tiras"
    },
    "hat": {
      "type": "number",
      "range": [
        0,
        2
      ],
      "default": 0,
      "semantic": "envolvente de hats: titileo"
    },
    "tom": {
      "type": "number",
      "range": [
        0,
        2
      ],
      "default": 0,
      "semantic": "envolvente de toms: cuarta voz del secuenciador"
    },
    "chaos": {
      "type": "number",
      "range": [
        0,
        1
      ],
      "default": 0.5,
      "semantic": "desorden: 1 = ruido (tiras y temblor), 0 = todo alineado"
    },
    "lock": {
      "type": "number",
      "range": [
        0,
        1
      ],
      "default": 0,
      "semantic": "cuánto se pega el contenido a la rejilla visible"
    },
    "shock": {
      "type": "number",
      "range": [
        0,
        2
      ],
      "default": 0,
      "semantic": "onda de choque tras el golpe (sacudida, canales, anillo)"
    },
    "tension": {
      "type": "number",
      "range": [
        0,
        1.5
      ],
      "default": 0,
      "semantic": "tensión acumulada del crescendo (compresión, brillo del acento)"
    },
    "drift": {
      "type": "number",
      "range": [
        -1,
        1
      ],
      "default": 0,
      "semantic": "deriva lenta (LFO): respiración en los respiros"
    },
    "text": {
      "type": "string",
      "semantic": "texto principal del shot (default shot.text)"
    }
  },
  "objects": [
    {
      "id": "size",
      "type": "let",
      "value": {
        "$expr": "min(330, fit('CLAC', S_w * 0.7))"
      }
    },
    {
      "id": "lamp",
      "type": "let",
      "value": 70
    },
    {
      "type": "gridlines",
      "lib": "K_tipo",
      "fn": "gridlines",
      "args": [
        "ctx",
        "api",
        {
          "cols": 4,
          "rows": 8,
          "alpha": {
            "$expr": "0.28 + 0.7 * lock"
          },
          "lit": {
            "$expr": "kick * 0.8"
          }
        }
      ]
    },
    {
      "id": "fila",
      "type": "repeat",
      "items": [
        [
          "PUM",
          "kick"
        ],
        [
          "TIC",
          "hat"
        ],
        [
          "CLAC",
          "snare"
        ],
        [
          "TOC",
          "tom"
        ]
      ],
      "fields": [
        "str",
        "track"
      ],
      "children": [
        {
          "id": "age",
          "type": "let",
          "value": {
            "$expr": "since(i)"
          }
        },
        {
          "type": "group",
          "when": "age >= 0",
          "children": [
            {
              "id": "en",
              "type": "let",
              "value": {
                "$expr": "pget(fila_track)"
              }
            },
            {
              "id": "p",
              "type": "let",
              "lib": "K_tipo",
              "fn": "pop",
              "args": [
                "api",
                {
                  "$expr": "age"
                },
                {
                  "from": 1.15
                }
              ],
              "fields": [
                "s",
                "a"
              ]
            },
            {
              "id": "cy",
              "type": "let",
              "value": {
                "$expr": "S_cy + ((i - 1.5) * S_h * 0.88) / 4"
              }
            },
            {
              "id": "J",
              "type": "let",
              "value": {
                "$expr": "shake(16, 9 + i)"
              },
              "fields": [
                "0",
                "1"
              ]
            },
            {
              "id": "sn",
              "type": "let",
              "value": {
                "$expr": "snapTo(S_x0, cy, lock * 0.5)"
              },
              "fields": [
                "0",
                "1"
              ]
            },
            {
              "type": "word",
              "lib": "K_tipo",
              "str": {
                "$expr": "fila_str"
              },
              "x": {
                "$expr": "sn_0 + J_0 + 50"
              },
              "y": {
                "$expr": "sn_1 + J_1"
              },
              "size": {
                "$expr": "size * p_s * (1 + 0.1 * en)"
              },
              "opts": {
                "align": "left",
                "color": {
                  "$expr": "en > 0.45 ? 'accent' : 'ink'"
                },
                "split": {
                  "$expr": "16 * exp(-age * 11) + 10 * en"
                }
              }
            },
            {
              "type": "shape",
              "shape": "rect",
              "color": {
                "$expr": "en > 0.1 ? 'accent' : 'shade'"
              },
              "alpha": {
                "$expr": "0.35 + 0.65 * clamp(en)"
              },
              "x": {
                "$expr": "S_x1 - 50 - lamp * (1 + 0.5 * en)"
              },
              "y": {
                "$expr": "cy - lamp * (1 + 0.5 * en) / 2"
              },
              "w": {
                "$expr": "lamp * (1 + 0.5 * en)"
              },
              "h": {
                "$expr": "lamp * (1 + 0.5 * en)"
              }
            }
          ]
        }
      ]
    },
    {
      "type": "focusOf",
      "lib": "K_tipo",
      "fn": "focusOf",
      "args": [
        "api",
        {
          "$expr": "len(boxes) > 0 ? boxes : vec(box(S_cx - 10, S_cy - 10, 20, 20))"
        },
        {
          "$lit": "secuenciador"
        }
      ]
    }
  ]
}
