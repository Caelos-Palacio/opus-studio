{
  "dsl": 1,
  "id": "R10",
  "doc": "CARGA (WS, empuje lento): la criatura de rodillas; la hoja de luz se forma y las líneas convergen. `tension` (señal 0→1).",
  "libs": {
    "R_mundo": "./R_mundo.mjs"
  },
  "params": {
    "tension": {
      "type": "number",
      "range": [
        0,
        1
      ],
      "unit": "×",
      "default": 0,
      "semantic": "carga del golpe final (hoja de luz, líneas convergentes, temblor)"
    }
  },
  "objects": [
    {
      "id": "tt",
      "type": "let",
      "semantic": "los últimos 4 fotogramas quietos: hold-cut",
      "value": {
        "$expr": "min(t, t1 - 0.13)"
      }
    },
    {
      "id": "tr",
      "type": "let",
      "value": {
        "$expr": "param('tension', tt)"
      }
    },
    {
      "id": "j",
      "type": "let",
      "value": {
        "$expr": "0.0025 * tr * sin(tt * 61)"
      }
    },
    {
      "id": "mundo",
      "type": "world",
      "lib": "R_mundo",
      "fn": "renderShot",
      "args": [
        "ctx",
        "api",
        "film",
        "shot",
        {
          "$expr": "tt"
        },
        {
          "view": {
            "x": {
              "$expr": "j"
            },
            "y": 0.02,
            "z": 0.95
          },
          "tension": {
            "$expr": "tr"
          },
          "mood": {
            "$expr": "1 - 0.5 * tr"
          }
        }
      ],
      "semantic": "la criatura, la rueda y el decorado 2.5D del plano (lee la fuerza de los golpes de OTROS planos: opaco a propósito)"
    }
  ]
}
