{
  "dsl": 1,
  "id": "R03",
  "doc": "IMPACTO (CU): ondas de choque y grietas en estrella desde el centro (13,4 s).",
  "libs": {
    "R_mundo": "./R_mundo.mjs"
  },
  "params": {
    "fuerza": {
      "type": "number",
      "range": [
        0.5,
        4.5
      ],
      "unit": "×",
      "default": 1,
      "semantic": "intensidad del golpe (estruendo: sacudida, flash, chispas); la dirige la memoria por la cadena de relaciones escala"
    }
  },
  "objects": [
    {
      "id": "mundo",
      "type": "world",
      "lib": "R_mundo",
      "fn": "renderShot",
      "args": [
        "ctx",
        "api",
        "film",
        "shot",
        "t",
        {
          "view": {
            "x": 0,
            "y": 0.06,
            "z": 2.1
          },
          "bleed": true,
          "caps": [
            {
              "str": "IMPACTO",
              "t0": {
                "$expr": "t0 + 2.3"
              },
              "t1": {
                "$expr": "t0 + 4.4"
              },
              "color": "accent",
              "at": {
                "$expr": "at(0.15, 0.5)"
              }
            }
          ]
        }
      ],
      "semantic": "la criatura, la rueda y el decorado 2.5D del plano (lee la fuerza de los golpes de OTROS planos: opaco a propósito)"
    }
  ]
}
