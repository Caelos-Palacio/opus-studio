{
  "dsl": 1,
  "id": "R14",
  "doc": "CIERRE (WS): rima con R01. La memoria (relación rima) pide repetir el encuadre y la posición del texto del primer plano; intensidad (escala adaptacion→amenaza) engorda el hilo del atacante; enfasis (peso de la rueda) su brillo. La pregunta queda abierta.",
  "libs": {
    "R_mundo": "./R_mundo.mjs"
  },
  "params": {
    "enfasis": {
      "type": "number",
      "range": [
        0,
        1
      ],
      "unit": "×",
      "default": 0.5,
      "semantic": "peso de memoria de la rueda: brillo del oro"
    },
    "intensidad": {
      "type": "number",
      "range": [
        0.5,
        3
      ],
      "unit": "×",
      "default": 1,
      "semantic": "presencia del atacante (relación escala adaptacion→amenaza)"
    },
    "rima": {
      "type": "json",
      "default": [],
      "semantic": "callbacks de rima [{ref, concepto}]: repetir el encuadre del plano referido (rol rima)"
    }
  },
  "objects": [
    {
      "id": "mundo",
      "type": "world",
      "lib": "R_mundo",
      "fn": "renderShot",
      "args": [
        "ctx",
        "api",
        "film",
        "shot",
        "t",
        {
          "view": {
            "x": 0,
            "y": {
              "$expr": "len(rima) > 0 ? 0 : 0.03"
            },
            "z": 1
          },
          "mood": {
            "$expr": "0.5 + 0.6 * enfasis"
          },
          "thread": {
            "x": -0.42,
            "k": {
              "$expr": "0.7 + 0.4 * intensidad"
            },
            "a": 1
          },
          "wheelEcho": 0,
          "caps": [
            {
              "str": {
                "$shot": "text"
              },
              "t0": {
                "$expr": "t0 + 0.5"
              },
              "t1": {
                "$expr": "t1 - 0.3"
              },
              "color": "ink",
              "at": {
                "$expr": "at(0.5, 0.955)"
              }
            }
          ]
        }
      ],
      "semantic": "la criatura, la rueda y el decorado 2.5D del plano (lee la fuerza de los golpes de OTROS planos: opaco a propósito)"
    }
  ]
}
