{
  "dsl": 1,
  "id": "P05",
  "doc": "10^9–10^12 m: la luz del Sol entra antes que el Sol; la órbita terrestre (ámbar) pasa por el centro: por ti.",
  "libs": {
    "P_mundo": "./P_mundo.mjs",
    "P_dsl": "./P_dsl.mjs"
  },
  "entities": {
    "win": {
      "lib": "P_mundo",
      "fn": "winRide",
      "fields": [],
      "reads": []
    }
  },
  "objects": [
    {
      "id": "viaje",
      "type": "world",
      "lib": "P_mundo",
      "fn": "ride",
      "args": [
        "ctx",
        "api",
        "film",
        "t"
      ],
      "semantic": "el viaje de escala: cielo, estrellas, suelo, sistema solar, ventana (continuidad exacta en cada corte)",
      "fields": [
        "so.ppm",
        "so.sx",
        "so.sy"
      ]
    },
    {
      "id": "AU",
      "type": "let",
      "lib": "P_dsl",
      "fn": "au",
      "args": []
    },
    {
      "id": "R",
      "type": "let",
      "when": "has(viaje_so_ppm)",
      "value": {
        "$expr": "AU * viaje_so_ppm"
      }
    },
    {
      "type": "focus",
      "x": {
        "$expr": "viaje_so_sx - R"
      },
      "y": {
        "$expr": "viaje_so_sy - R"
      },
      "w": {
        "$expr": "2 * R"
      },
      "h": {
        "$expr": "2 * R"
      },
      "label": "órbita terrestre",
      "weight": 1,
      "hollow": 0.85,
      "when": "has(viaje_so_ppm) && R > 30 && R < 190"
    },
    {
      "type": "focus",
      "x": {
        "$expr": "viaje_so_sx - 8"
      },
      "y": {
        "$expr": "viaje_so_sy - 8"
      },
      "w": {
        "$expr": "16"
      },
      "h": {
        "$expr": "16"
      },
      "label": "sol",
      "weight": 1,
      "when": "has(viaje_so_ppm) && R <= 30"
    },
    {
      "id": "contador",
      "type": "hud",
      "lib": "P_mundo",
      "fn": "hud",
      "args": [
        "api",
        "film",
        "t"
      ],
      "semantic": "contador 10^n m con morph glifo a glifo"
    },
    {
      "id": "rotulo",
      "type": "caption",
      "lib": "P_mundo",
      "fn": "caption",
      "args": [
        "api",
        "film",
        "t",
        26.0,
        27.95,
        {
          "$lit": "NUESTRA ÓRBITA"
        },
        {
          "$lit": "3\\times10^{11}\\,\\mathrm{m}"
        }
      ],
      "semantic": "rótulo de hito"
    }
  ]
}
