{
  "dsl": 1,
  "id": "M07",
  "doc": "Media vuelta. El ángulo de π (violeta) sobre la semicircunferencia y la ecuación que lo declara: e^{iπ} = −1 y e^{iπ} + 1 = 0. Concepto nuevo: «media vuelta», pegado al arco indicador.",
  "libs": {
    "M_mundo": "./M_mundo.mjs"
  },
  "fns": {
    "X": {
      "lib": "M_mundo",
      "fn": "X"
    },
    "Y": {
      "lib": "M_mundo",
      "fn": "Y"
    },
    "cis": {
      "lib": "M_mundo",
      "fn": "cis"
    }
  },
  "entities": {
    "z": {
      "lib": "M_mundo",
      "fn": "zEntity"
    }
  },
  "objects": [
    {
      "id": "V",
      "type": "let",
      "lib": "M_mundo",
      "fn": "view",
      "args": [
        "film",
        "t"
      ],
      "fields": [
        "ox",
        "oy",
        "u"
      ]
    },
    {
      "id": "S",
      "type": "let",
      "value": {
        "$expr": "k * 1.5"
      }
    },
    {
      "id": "r",
      "type": "let",
      "value": {
        "$expr": "0.36 * V_u"
      }
    },
    {
      "id": "p",
      "type": "let",
      "value": {
        "$expr": "seg(t, 73.0, 75.4)"
      }
    },
    {
      "id": "mundo",
      "type": "plot",
      "lib": "M_mundo",
      "fn": "drawWorld",
      "args": [
        "ctx",
        "api",
        "film",
        "t"
      ],
      "semantic": "plano complejo: eje real, imaginario, arco y punto z"
    },
    {
      "id": "marcas",
      "type": "axis",
      "lib": "M_mundo",
      "fn": "drawTicks",
      "args": [
        "api",
        "film",
        "t"
      ],
      "semantic": "etiquetas numéricas de la recta/plano"
    },
    {
      "id": "ecuacion",
      "type": "equation",
      "steps": {
        "lib": "M_mundo",
        "export": "EQ"
      },
      "semantic": "la ecuación única que muta"
    },
    {
      "id": "angulo",
      "type": "curve",
      "when": "p > 0",
      "semantic": "el ángulo recorrido, de 0 a π, alrededor del origen",
      "n": {
        "$expr": "max(2, ceil(p * 80))"
      },
      "x": {
        "$expr": "X(V, cis(pi * p * i / n, 0.36))"
      },
      "y": {
        "$expr": "Y(V, cis(pi * p * i / n, 0.36))"
      },
      "color": "quant",
      "lineWidth": {
        "$expr": "2.2 * k"
      },
      "alpha": {
        "$expr": "0.9 * (1 - seg(t, 80.0, 81.0))"
      },
      "cap": "round"
    },
    {
      "id": "al",
      "type": "let",
      "value": {
        "$expr": "seg(t, 73.0, 73.8) * (1 - seg(t, 79.4, 80.6))"
      }
    },
    {
      "id": "media",
      "type": "group",
      "when": "al > 0.05",
      "children": [
        {
          "type": "focus",
          "x": {
            "$expr": "V_ox - 60 * S"
          },
          "y": {
            "$expr": "V_oy - r - 5 * S"
          },
          "w": {
            "$expr": "120 * S"
          },
          "h": {
            "$expr": "10 * S"
          },
          "label": "arco",
          "weight": 0.6,
          "hollow": 0.5
        },
        {
          "type": "text",
          "text": "media vuelta",
          "x": {
            "$expr": "V_ox"
          },
          "y": {
            "$expr": "V_oy - r - 52 * S"
          },
          "role": "body",
          "alpha": {
            "$expr": "al"
          },
          "color": "quant"
        }
      ]
    }
  ]
}
