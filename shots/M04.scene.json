{
  "dsl": 1,
  "id": "M04",
  "doc": "Si la velocidad apunta de lado. La flecha gira 90° (×i) y el punto deja de crecer: gira, dibujando un arco ámbar. Concepto nuevo: «girar». La etiqueta nace pegada al ángulo de 90°.",
  "libs": {
    "M_mundo": "./M_mundo.mjs"
  },
  "entities": {
    "z": {
      "lib": "M_mundo",
      "fn": "zEntity"
    }
  },
  "objects": [
    {
      "id": "S",
      "type": "let",
      "value": {
        "$expr": "k * 1.5"
      }
    },
    {
      "id": "mundo",
      "type": "plot",
      "lib": "M_mundo",
      "fn": "drawWorld",
      "args": [
        "ctx",
        "api",
        "film",
        "t"
      ],
      "semantic": "plano complejo: eje real, imaginario, arco y punto z",
      "fields": [
        "V.u"
      ]
    },
    {
      "id": "marcas",
      "type": "axis",
      "lib": "M_mundo",
      "fn": "drawTicks",
      "args": [
        "api",
        "film",
        "t"
      ],
      "semantic": "etiquetas numéricas de la recta/plano"
    },
    {
      "id": "ecuacion",
      "type": "equation",
      "steps": {
        "lib": "M_mundo",
        "export": "EQ"
      },
      "semantic": "la ecuación única que muta"
    },
    {
      "id": "v",
      "type": "let",
      "lib": "M_mundo",
      "fn": "velocity",
      "args": [
        "film",
        "t"
      ],
      "fields": [
        "x0",
        "y0"
      ]
    },
    {
      "id": "al",
      "type": "let",
      "value": {
        "$expr": "seg(t, 36.4, 37.0) * (1 - seg(t, 39.6, 40.6))"
      }
    },
    {
      "id": "giro",
      "type": "group",
      "when": "has(v) && al > 0.05",
      "children": [
        {
          "id": "r0",
          "type": "let",
          "value": {
            "$expr": "0.3 * mundo_V_u"
          }
        },
        {
          "type": "focus",
          "x": {
            "$expr": "v_x0"
          },
          "y": {
            "$expr": "v_y0 - r0"
          },
          "w": {
            "$expr": "r0"
          },
          "h": {
            "$expr": "r0"
          },
          "label": "giro",
          "weight": 0.6,
          "hollow": 0.6
        },
        {
          "type": "text",
          "text": "girar 90°",
          "x": {
            "$expr": "v_x0 + r0 + 12 * S"
          },
          "y": {
            "$expr": "v_y0 - r0 * 0.9 - 8 * S"
          },
          "role": "body",
          "align": "left",
          "alpha": {
            "$expr": "al"
          },
          "color": "quant"
        }
      ]
    },
    {
      "id": "cierre",
      "type": "text",
      "text": {
        "$shot": "text"
      },
      "x": {
        "$expr": "W / 2"
      },
      "y": {
        "$expr": "H * 0.865"
      },
      "role": "h2",
      "alpha": {
        "$expr": "seg(t, 35.2, 36.4) * (1 - seg(t, 41.0, 41.8))"
      }
    },
    {
      "id": "nocrece",
      "type": "text",
      "text": "no crece: gira",
      "x": {
        "$expr": "W / 2"
      },
      "y": {
        "$expr": "H * 0.865"
      },
      "role": "h2",
      "alpha": {
        "$expr": "seg(t, 42.0, 43.2) * (1 - seg(t, 46.0, 46.8))"
      }
    }
  ]
}
