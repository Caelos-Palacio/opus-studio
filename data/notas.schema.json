{
  "title": "Notas del usuario por versión (data/notas.json; engine/metrics.mjs calibrate)",
  "type": "object",
  "required": [
    "notas"
  ],
  "additionalProperties": false,
  "properties": {
    "descripcion": {
      "type": "string",
      "maxLength": 2000
    },
    "notas": {
      "type": "array",
      "maxItems": 5000,
      "items": {
        "type": "object",
        "required": [
          "film",
          "version",
          "dim",
          "nota"
        ],
        "additionalProperties": false,
        "properties": {
          "film": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "dim": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "nota": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 10
              },
              {
                "type": "null"
              }
            ]
          },
          "texto": {
            "type": "string",
            "maxLength": 2000
          },
          "fuente": {
            "type": "string",
            "maxLength": 200
          },
          "medible": {
            "type": "boolean"
          },
          "voz": {
            "type": "object",
            "description": "¿tuvo voz? (spec 013): sí/no + comentario; opcional",
            "required": [
              "tuvo"
            ],
            "additionalProperties": false,
            "properties": {
              "tuvo": {
                "enum": [
                  "sí",
                  "no"
                ]
              },
              "texto": {
                "type": "string",
                "maxLength": 2000
              }
            }
          }
        }
      }
    }
  }
}
