{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EDL de montaje no destructivo (engine/film.mjs buildTimeMap, engine/cut.mjs)",
  "type": "object",
  "required": ["items"],
  "additionalProperties": false,
  "properties": {
    "note": { "type": "string", "maxLength": 2000 },
    "items": { "type": "array", "minItems": 1, "maxItems": 5000, "items": { "$ref": "#/$defs/item" } }
  },
  "$defs": {
    "item": {
      "type": "object",
      "required": ["src"],
      "additionalProperties": false,
      "properties": {
        "src": { "anyOf": [
          { "type": "string", "minLength": 1, "maxLength": 200 },
          { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number", "minimum": 0, "maximum": 86400 } }
        ] },
        "speed": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000 },
        "reverse": { "type": "boolean" },
        "hold": { "type": "number", "minimum": 0, "maximum": 3600 },
        "label": { "type": "string", "maxLength": 500 }
      }
    }
  }
}
