{
"meta": {"id":"comparar","grupo":"plano","resumen":"dos cosas lado a lado y una diferencia que se marca","tags":["comparar","diferencia","dos","contraste","barras"],"params":{"diff":"number","marcaEn":"number"},"cuando":"dos magnitudes o estados cuya distancia es la idea del plano"},
