  {"id":"foco","type":"focus","x":{"$expr":"S_cx + 70"},"y":{"$expr":"S_cy + 120 - 160 * (1 + diff)"},"w":120,"h":{"$expr":"160 * (1 + diff)"},"label":"B"},
  {"id":"nombra","type":"text","text":"$hueco: la diferencia, dicha","x":{"$expr":"S_cx"},"y":{"$expr":"S_cy + 175"},"role":"body","align":"center","alpha":{"$expr":"seg(lt, marcaEn, marcaEn + 0.5)"}}
 ]}
