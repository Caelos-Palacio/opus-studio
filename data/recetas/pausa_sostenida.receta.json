{
"meta": {"id":"pausa_sostenida","grupo":"plano","resumen":"nada ocurre: el fondo respira y el silencio se sostiene","tags":["pausa","silencio","respirar","quieto","sostener","calma"],"params":{"tam":"number","respira":"number"},"cuando":"tras un golpe, para que el espectador lo asimile sin que nada lo distraiga"},
