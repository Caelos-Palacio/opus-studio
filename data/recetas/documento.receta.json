  {"id":"l2","type":"text","text":"$hueco: segunda línea: lo que consta","x":{"$expr":"S_cx - 240"},"y":{"$expr":"S_cy"},"role":"body","color":"paper","alpha":{"$expr":"seg(lt, 0.4 + linea, 0.4 + 2 * linea)"}},
