{
  "title": "Escena world3d como DATOS (api.world3d; spec 004)",
  "type": "object",
  "required": [
    "objects"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "maxLength": 100
    },
    "background": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 64
        },
        {
          "type": "object",
          "properties": {
            "top": {
              "type": "string",
              "maxLength": 64
            },
            "bottom": {
              "type": "string",
              "maxLength": 64
            },
            "stops": {
              "type": "array",
              "minItems": 2,
              "maxItems": 8,
              "items": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 64
                  },
                  {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2
                  }
                ]
              }
            }
          }
        }
      ]
    },
    "fog": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        {
          "type": "object",
          "properties": {
            "density": {
              "type": "number",
              "minimum": 0,
              "maximum": 10
            },
            "far": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1000000.0
            }
          }
        }
      ]
    },
    "ground": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "object",
          "properties": {
            "color": {
              "type": "string",
              "maxLength": 64
            },
            "size": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1000000.0
            },
            "contact": {
              "type": "boolean"
            },
            "lit": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "v2: cuánto se ilumina el suelo en el charco de luz (por defecto el del estilo world3d.groundLit)"
            },
            "catcher": {
              "type": "boolean",
              "description": "v2: el suelo solo dibuja la sombra proyectada (alfa) para componerla sobre el suelo 2D del shot"
            },
            "mat": {
              "type": "string",
              "maxLength": 32
            },
            "y": {
              "type": "number",
              "minimum": -1000000.0,
              "maximum": 1000000.0
            }
          }
        }
      ]
    },
    "camera": {
      "type": "object",
      "properties": {
        "fov": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 170
        },
        "near": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000000.0
        },
        "far": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000000.0
        },
        "target": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number",
            "minimum": -1000000.0,
            "maximum": 1000000.0
          }
        },
        "dist": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000000.0
        },
        "az": {
          "type": "number",
          "minimum": -3600,
          "maximum": 3600
        },
        "el": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "fromShot": {
          "type": "boolean",
          "description": "v2: deriva elevación/lente del horizonte y la línea de suelo del shot"
        },
        "scale": {
          "type": "string",
          "maxLength": 16
        },
        "horizon": {
          "type": "number",
          "minimum": -5,
          "maximum": 5
        },
        "override": {
          "type": "boolean"
        },
        "heroic": {
          "type": "boolean"
        },
        "groundY": {
          "type": "number",
          "minimum": -5,
          "maximum": 5
        },
        "ppm": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000000000.0
        },
        "roll": {
          "type": "number",
          "minimum": -360,
          "maximum": 360
        }
      }
    },
    "objects": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "properties": {
          "shape": {
            "type": "string",
            "maxLength": 32
          },
          "size": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1000000.0
              },
              {
                "type": "array",
                "minItems": 2,
                "maxItems": 3,
                "items": {
                  "type": "number",
                  "minimum": -1000000.0,
                  "maximum": 1000000.0
                }
              }
            ]
          },
          "pos": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number",
              "minimum": -1000000.0,
              "maximum": 1000000.0
            }
          },
          "color": {
            "type": "string",
            "maxLength": 64
          },
          "colors": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "string",
              "maxLength": 64
            }
          },
          "mat": {
            "type": "string",
            "maxLength": 32
          },
          "outline": {
            "type": "boolean"
          },
          "contact": {
            "type": "boolean"
          },
          "data": {
            "type": "array",
            "maxItems": 5000000,
            "items": {
              "type": "number",
              "minimum": -1000000000.0,
              "maximum": 1000000000.0
            }
          },
          "instances": {
            "type": "object",
            "properties": {
              "shape": {
                "type": "string",
                "maxLength": 32
              },
              "size": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number",
                  "minimum": -1000000.0,
                  "maximum": 1000000.0
                }
              }
            }
          },
          "cast": {
            "type": "boolean",
            "description": "v2: proyecta sombra (por defecto sí si es sólido con luz)"
          },
          "id": {
            "type": "string",
            "maxLength": 100
          },
          "rot": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number"
            }
          }
        }
      }
    }
  }
}
